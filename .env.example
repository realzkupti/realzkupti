APP_NAME="TailAdmin Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration - Support Multiple Databases
# Options: mysql, pgsql, sqlite, sqlsrv
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailadmin
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL Example
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tailadmin
# DB_USERNAME=postgres
# DB_PASSWORD=

# SQLite Example
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# SQL Server Example
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=tailadmin
# DB_USERNAME=sa
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
